# Copy to infra/.env (docker compose) or export in your shell (Python, dbt, Dagster).
# The defaults below are local development values only. Use real secrets on the VPS.
BIS_PG_HOST=127.0.0.1
BIS_PG_PORT=55432
BIS_PG_USER=bis
BIS_PG_PASSWORD=bis_dev
BIS_MARKETING_PORT=8101
BIS_MARKETING_API_URL=http://127.0.0.1:8101
# Read-only database role used by the API (created by `bis setup`)
BIS_API_DB_PASSWORD=bis_api_dev
BIS_API_PORT=8102
# Dagster schedule for one simulated day per tick; enable for unattended replay
BIS_SCHEDULE_CRON=0 2 * * *
BIS_SCHEDULE_ENABLED=false
