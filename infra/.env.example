# Template for infra/.env (git-ignored). `bis setup` copies it and replaces every
# "generated-by-bis-setup" with a random secret. docker compose, the CLI, Dagster and the
# tests read infra/.env. On the VPS set real values; never commit infra/.env.
BIS_PG_HOST=127.0.0.1
BIS_PG_PORT=55432
BIS_PG_USER=bis
BIS_PG_PASSWORD=generated-by-bis-setup
BIS_MARKETING_PORT=8101
BIS_MARKETING_API_URL=http://127.0.0.1:8101
# Read-only database role used by the API (created by `bis setup`)
BIS_API_DB_PASSWORD=generated-by-bis-setup
BIS_API_PORT=8102
BIS_FRONTEND_PORT=8103
# Login (Keycloak, realm "bis"). Admin and demo user passwords are generated by `bis setup`.
BIS_AUTH_ENABLED=true
BIS_KEYCLOAK_PORT=8180
BIS_KEYCLOAK_ADMIN_PASSWORD=generated-by-bis-setup
BIS_DEMO_USER=demo
BIS_DEMO_PASSWORD=generated-by-bis-setup
# Dagster schedule for one simulated day per tick; enable for unattended replay
BIS_SCHEDULE_CRON=0 2 * * *
BIS_SCHEDULE_ENABLED=false
# Alerts (defaults target the local Mailpit test inbox, UI on http://127.0.0.1:8025)
BIS_SMTP_HOST=127.0.0.1
BIS_SMTP_PORT=1025
BIS_SMTP_USER=
BIS_SMTP_PASSWORD=
BIS_SMTP_STARTTLS=false
BIS_ALERT_FROM=BI-System <alerts@bis.local>
BIS_ALERT_TO=team@bis.local
BIS_DASHBOARD_URL=http://127.0.0.1:5173
BIS_MAILPIT_SMTP_PORT=1025
BIS_MAILPIT_UI_PORT=8025
# AI analyst. Without credentials the daily briefing is skipped.
ANTHROPIC_API_KEY=
BIS_LLM_PROVIDER=anthropic
BIS_LLM_MODEL=claude-opus-5-5
BIS_LLM_EFFORT=medium
