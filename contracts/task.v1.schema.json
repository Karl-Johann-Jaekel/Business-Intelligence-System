{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Karl-Johann-Jaekel/Business-Intelligence-System/contracts/task.v1.schema.json",
  "title": "task.v1",
  "description": "A scoped assignment for an agent of the Central-Intelligence-Agent: one department, one objective, an allow-list of tools and a budget. Created by the central agent, by an approved spawn request, by the admin, a schedule or a guest question. Status: draft (A0).",
  "type": "object",
  "required": ["schema_version", "task_id", "run_id", "parent_task_id", "depth", "requested_by", "department", "objective", "refs", "allowed_tools", "budget", "output_schema", "status", "data_class", "created_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "task.v1"},
    "task_id": {"$ref": "common.v1.schema.json#/$defs/uuid"},
    "run_id": {"$ref": "common.v1.schema.json#/$defs/uuid", "description": "Run of the central agent this task belongs to"},
    "parent_task_id": {"anyOf": [{"$ref": "common.v1.schema.json#/$defs/uuid"}, {"type": "null"}], "description": "null for tasks the central agent creates itself"},
    "depth": {"type": "integer", "minimum": 1, "description": "1 = delegated by the central agent, 2 and more = spawned by a department agent"},
    "requested_by": {
      "type": "object",
      "required": ["kind", "department"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["central", "department", "admin", "guest", "schedule"]},
        "department": {"anyOf": [{"$ref": "common.v1.schema.json#/$defs/department"}, {"type": "null"}], "description": "Requesting department; required when kind = department"}
      }
    },
    "department": {"$ref": "common.v1.schema.json#/$defs/department"},
    "objective": {"type": "string", "minLength": 10, "maxLength": 1000, "description": "What to find out, phrased as a question or goal"},
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "insight_ids": {"type": "array", "items": {"$ref": "common.v1.schema.json#/$defs/uuid"}},
        "kpis": {"type": "array", "items": {"$ref": "common.v1.schema.json#/$defs/kpi_key"}},
        "entities": {"type": "array", "items": {"$ref": "entity-namespace.v1.schema.json#/$defs/entity_ref"}},
        "period": {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": {"type": "string", "format": "date"},
            "end": {"type": "string", "format": "date"}
          }
        }
      }
    },
    "allowed_tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.v1.schema.json#/$defs/tool"}},
    "budget": {
      "type": "object",
      "required": ["max_steps", "max_tokens", "max_cost_eur"],
      "additionalProperties": false,
      "properties": {
        "max_steps": {"type": "integer", "minimum": 1, "maximum": 50},
        "max_tokens": {"type": "integer", "minimum": 1},
        "max_cost_eur": {"type": "number", "minimum": 0}
      }
    },
    "due": {"type": ["string", "null"], "format": "date", "description": "Simulation date by which the task must be completed; afterwards it counts as overdue"},
    "output_schema": {"const": "finding.v1"},
    "status": {"enum": ["queued", "running", "completed", "failed", "budget_exceeded", "rejected", "cancelled"]},
    "status_reason": {"type": ["string", "null"], "description": "Why a task failed, was rejected (spawn policy) or cancelled"},
    "data_class": {"$ref": "common.v1.schema.json#/$defs/data_class"},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "$comment": "Top-level tasks sit at depth 1; spawned tasks have a parent and sit deeper.",
      "if": {"properties": {"parent_task_id": {"type": "null"}}},
      "then": {"properties": {"depth": {"const": 1}}},
      "else": {"properties": {"depth": {"minimum": 2}}}
    },
    {
      "$comment": "A spawn request names the requesting department.",
      "if": {"properties": {"requested_by": {"properties": {"kind": {"const": "department"}}}}},
      "then": {"properties": {"requested_by": {"properties": {"department": {"$ref": "common.v1.schema.json#/$defs/department"}}}}}
    },
    {
      "$comment": "Every task that did not complete says why.",
      "if": {"properties": {"status": {"enum": ["rejected", "failed", "cancelled", "budget_exceeded"]}}},
      "then": {"required": ["status_reason"], "properties": {"status_reason": {"type": "string", "minLength": 1}}}
    }
  ]
}
